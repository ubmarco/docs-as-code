# Commonly used for local settings and secrets
.env

# Bazel
bazel-*
user.bazelrc

# Ruff
.ruff_cache

# docs build artifacts
_build/
# NOTE (ubtn branch): docs/ubproject.toml is intentionally NOT ignored here
# (upstream ignores it). needs-config-writer (src/extensions/score_sync_toml)
# regenerates it as a side effect of any Sphinx/Bazel docs build, which is
# why it is ignored upstream -- but ubtrace-native's `ubc build html docs`
# needs a checked-in, standalone copy (see tools/ubtn/).
# tools/ubtn/ubtrace-prepare.sh restores the checked-in copy after
# `bazel run //:docs_check` runs, so that regeneration never leaks into a
# real ubtn build.

# tools/module_verification_reports.py downstream repository checkouts
/.cache/

# Vale - editorial style guide
.vale.ini
styles/

# direnv - folder-specific bash configuration
.envrc

# Python
.venv*
__pycache__/
/.coverage

# bug: This file is created in repo root on test discovery.
/consumer_test.log
.clwb

# AI
/.codex
/.claude
